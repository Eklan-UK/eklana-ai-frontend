# =============================================================================
# Eklan / Eklana AI — environment template
# Copy to `.env` or `.env.local` and replace placeholder values.
# `.env` and `.env.local` are gitignored; commit `.env.example` only.
# =============================================================================

# --- Core app URLs (local dev often uses http://localhost:3000) -------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: explicit Better Auth base URL (defaults from NEXT_PUBLIC_API_URL / Vercel)
BETTER_AUTH_URL=http://localhost:3000
# Optional: override session cookie Secure flag (otherwise derived from BETTER_AUTH_URL https://)
# Use COOKIE_SECURE=false only for HTTP dev/staging; production HTTPS should use the default.
# COOKIE_SECURE=true
# COOKIE_SECURE=false

# --- Vercel: staging vs production (avoid login redirect loops) ----------------
# Use ONE canonical origin per deployment — the URL users open in the browser:
#   Production:  NEXT_PUBLIC_API_URL=https://app.eklan.ai
#                BETTER_AUTH_URL=https://app.eklan.ai
#                NEXT_PUBLIC_APP_URL=https://app.eklan.ai
#   Staging:     NEXT_PUBLIC_API_URL=https://staging.eklan.ai
#                BETTER_AUTH_URL=https://staging.eklan.ai
#                NEXT_PUBLIC_APP_URL=https://staging.eklan.ai
# Do not point staging’s NEXT_PUBLIC_API_URL at production (or vice versa) unless you
# intentionally split UI/API; this app’s axios client uses same-origin /api/v1.
#
# Verify in DevTools → Application → Cookies on that host after login:
#   Name: better-auth.session_token (Better Auth default cookie prefix)

# --- Database ---------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/your-database-name

# --- Auth secrets (use long random strings in production) -------------------
BETTER_AUTH_SECRET=replace-with-long-random-secret
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
# Optional token lifetimes (if your app reads these)
ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# --- Troubleshooting: “kicked to login every click” --------------------------
# 1) Confirm /api/v1 requests go to the SAME host as the page (Network tab).
# 2) Application → Cookies: session cookie must exist on that host; if Secure but you use HTTP,
#    set BETTER_AUTH_URL to http://… and COOKIE_SECURE=false (see src/lib/api/better-auth.ts).
# 3) Inspect failing responses: repeated 401 → see axios interceptor in src/lib/api/axios.ts.
# 4) If session is empty, fix URLs/secrets above; Next middleware does not validate sessions.

# --- CORS / deployment ------------------------------------------------------
# Comma-separated extra browser origins for Better Auth (trustedOrigins).
# Canonical origins (localhost, app.eklan.ai, staging.eklan.ai) are always merged; use this for previews or extra domains.
# Example (Vercel Preview UI): WHITELIST_ORIGINS=https://your-app-git-branch-team.vercel.app
WHITELIST_ORIGINS=
# Set automatically on Vercel; optional override for client
NEXT_PUBLIC_VERCEL_URL=

# --- Super admin seed / bootstrap (see src/lib/api/config.ts) ---------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=

# Staff learner accounts that always receive Pro (comma-separated; merged with built-in defaults).
# Defaults: sa@eklan.ai, bri8kingsley@gmail.com, dv@eklan.ai, afolabi.aanu@gmail.com, michael.jarod.turner@gmail.com
FOREVER_PREMIUM_EMAILS=

# --- OAuth (optional) --------------------------------------------------------
# Better Auth Google sign-in only (openid / profile / email). Register redirect:
#   {BETTER_AUTH_URL}/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: extra OAuth client IDs for mobile/Expo ID tokens (verify-id-token accepts any listed aud).
# Either set all at once:
# GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,expo-web-client-id.apps.googleusercontent.com
# Or add mobile alongside GOOGLE_CLIENT_ID:
# GOOGLE_MOBILE_CLIENT_ID=
# GOOGLE_EXPO_CLIENT_ID=
# Tutor Google Calendar connect (separate OAuth client). Register redirect:
#   {BETTER_AUTH_URL}/api/v1/tutor/google-calendar/callback
# Scopes: calendar.events, offline refresh for scheduling.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Multiline PEM often loaded differently in production; set as needed
APPLE_PRIVATE_KEY=

# --- Email: SMTP (optional) -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Email: Gmail alternative (optional) ----------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Display name + address. Bare addresses are wrapped as "Eklan" <addr> in code.
EMAIL_FROM="Eklan <hello@eklan.ai>"
# Used in some API routes / web-push mailto
SUPPORT_EMAIL=

# --- Amplitude (client — exposed to browser) --------------------------------
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# Guides & Surveys (NPS pop-ups). On by default; set to false to disable.
# NEXT_PUBLIC_AMPLITUDE_ENGAGEMENT=false
# Data center for Guides & Surveys CDN/API (US or EU — match your Amplitude project)
# NEXT_PUBLIC_AMPLITUDE_SERVER_ZONE=EU
# Server-side ingest region for /api/v1/analytics/amplitude proxy (US or EU)
# AMPLITUDE_SERVER_ZONE=EU

# --- Firebase (client — NEXT_PUBLIC_* are exposed to the browser) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin (server) ------------------------------------------------
# Option A (recommended locally): path to downloaded service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-adminsdk.json
# Option B (Vercel / inline): full JSON on one line (not just "{")
FIREBASE_SERVICE_ACCOUNT=

# --- Web Push / VAPID (optional) -------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Speechace (server API routes use SPEECHACE_*; set your real key) -------
SPEECHACE_API_KEY=
SPEECHACE_API_ENDPOINT=https://api.speechace.co
# Client-side direct service (if used)
NEXT_PUBLIC_SPEECHACE_API_KEY=
NEXT_PUBLIC_SPEECHACE_API_ENDPOINT=https://api.speechace.co

# --- Google Gemini (optional) ----------------------------------------------
GEMINI_API_KEY=
# Optional: low-latency text chat + /api/v1/ai/chat streaming (default: gemini-2.5-flash-lite)
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# Post-session JSON summary: primary and fallback (defaults below; 2.0 models may 404 for new API users)
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash
# GEMINI_SUMMARY_FALLBACK_MODEL=gemini-2.5-flash-lite

# --- ElevenLabs TTS (optional) ----------------------------------------------
ELEVEN_LABS_API_KEY=
# Controls the AI voice used across the entire app (chatbox, drills, etc.).
# Find your voice IDs at https://elevenlabs.io/app/voice-library or via the Voices API.
# If unset, the app falls back to ElevenLabs "Rachel" (21m00Tcm4TlvDq8ikWAM) and logs a warning on startup.
ELEVEN_LABS_DEFAULT_VOICE_ID=
# Optional: override default eleven_flash_v2_5 (see src/services/tts-config.ts)
# ELEVEN_LABS_TTS_MODEL_ID=eleven_flash_v2_5

# Celebration MP3 returned in POST /drills/:id/complete effects (Vercel Blob)
CELEBRATION_SOUND_URL=
# Optional: same URL for web client playback (must be NEXT_PUBLIC_* in the browser bundle)
NEXT_PUBLIC_CELEBRATION_SOUND_URL=
# Perfect-score (100%) celebration MP3 — replaces CELEBRATION_SOUND_URL when Math.round(score) >= 100
CELEBRATION_SOUND_URL_100=
# Optional: same perfect-score URL for web client playback (Pattern A review + mid-item "perfect" celebrations)
NEXT_PUBLIC_CELEBRATION_SOUND_URL_100=

# --- Cloudinary (optional) --------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Classes / video providers (see CLASSES-IMPLEMENTATION.md at repo root) ----
# Default IANA timezone for schedule buckets if not set per class (optional)
CLASSES_DEFAULT_TIMEZONE=UTC
# Google Calendar API (optional — Meet links / calendar events via service account JSON)
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# Tutor calendar OAuth uses GOOGLE_CALENDAR_CLIENT_ID / GOOGLE_CALENDAR_CLIENT_SECRET above.
# Zoom Server-to-Server OAuth or OAuth app (optional — Phase 6)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# --- Vercel Cron (production) -----------------------------------------------
# Required on Vercel: Vercel sends Authorization: Bearer <CRON_SECRET> on each
# scheduled cron invocation (see vercel.json). Generate: openssl rand -hex 32
CRON_SECRET=

# Optional local verbose cron JSON (debug arrays + error strings). Never set in production.
CRON_DEBUG=false

# --- Class session reminders (Phase 7 — cron / external scheduler) ---------
# GET /api/v1/cron/class-session-reminders with Authorization: Bearer <secret>
# Production: Vercel uses CRON_SECRET. Local: optional route secret or CRON_SECRET.
# Local cron tester: copy scripts/local-class-cron.example.mjs → scripts/local-class-cron.mjs (gitignored)
CLASS_REMINDER_CRON_SECRET=

# --- Post-session NPS form emails (cron / external scheduler) ---------------
# GET /api/v1/cron/class-session-nps with Authorization: Bearer <secret>
# Production: Vercel uses CRON_SECRET. Local: optional route secret or CRON_SECRET.
CLASS_NPS_CRON_SECRET=

# --- Drill reminders (cron / external scheduler) ------------------------------
# GET /api/v1/cron/drill-streak-reminder — rolling streak nudge (every 30 min)
# GET /api/v1/cron/drill-daily-practice-reminder — hourly; sends at 6 PM each learner's local time
#   when they have not completed a qualifying drill (score ≥ 70) that local calendar day.
# Debug: CRON_DEBUG=true plus ?debug=1&learnerId=...&timezone=America/New_York on the cron URL.
# Production: Vercel uses CRON_SECRET. Local: optional route secret or CRON_SECRET.
DRILL_REMINDER_CRON_SECRET=

# --- Weekly drill digest (cron / external scheduler) --------------------------
# GET /api/v1/cron/weekly-drill-digest — Monday 09:00 UTC (outstanding pending/in-progress/overdue assignments; excludes precision_clinic)
# Production: Vercel uses CRON_SECRET. Local: optional route secret or CRON_SECRET.
# Generate: openssl rand -hex 32
WEEKLY_DRILL_DIGEST_CRON_SECRET=

# --- Weekly challenge generation (cron / external scheduler) ----------------
# GET /api/v1/cron/weekly-challenge
# Production: Vercel uses CRON_SECRET. Local: optional route secret or CRON_SECRET.
WEEKLY_CHALLENGE_CRON_SECRET=

# --- Stripe (server-only — never expose to browser) -------------------------
# Secret key: use a Restricted API Key (rk_live_) in production; sk_test_ for dev.
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
# (use the whsec_ printed by `stripe listen` during local development)
STRIPE_WEBHOOK_SECRET=
# Monthly Pro Price ID (~US$1.99). All new Checkouts use this Price.
# Set this to the Stripe Price ID for the $1.99 monthly plan (Dashboard → Products).
# Test vs live Price IDs must match STRIPE_SECRET_KEY mode.
# Monthly Pro (~US$1.99). All new Checkouts use this Price ID.
# Ops: ensure next renewal is $1.99 for everyone — releases bad Phase 7 schedules
# that still point Portal “next payment” at US$20, and schedules non-$1.99 subs:
#   npm run migrate:to-monthly-199                 # dry-run (look for would_release_bad_schedule)
#   npm run migrate:to-monthly-199 -- --execute
# Then re-check Stripe Customer Portal: next estimated payment must be US$1.99.
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
# Checkout success/cancel URLs — must match your app host (see NEXT_PUBLIC_APP_URL at top of file)

# --- Apple In-App Purchase (Path A — StoreKit on iOS, server-only secrets) ---
# Separate from APPLE_CLIENT_ID / Sign in with Apple OAuth keys above.
# Never use NEXT_PUBLIC_* for these — mobile calls POST /api/v1/apple/verify on your API host.
#
# REQUIRED for POST /api/v1/apple/verify and POST /api/v1/webhooks/apple:
#   Issuer ID, Key ID, .p8  → App Store Connect → Users and Access → Integrations → App Store Connect API
#   Bundle ID               → developer.apple.com → Identifiers (must match iOS app / EAS)
#   Product ID              → App Store Connect → app → Subscriptions → Product ID
#   Environment             → sandbox (dev/TestFlight) or production (App Store live)
#
# REQUIRED (not optional):
#   APPLE_APP_APPLE_ID             — numeric App Store app id; REQUIRED when ENVIRONMENT=production
#                                     (isAppleIapConfigured() returns false / IAP is treated as unconfigured
#                                     without it in production). Optional in sandbox.
#
# OPTIONAL:
#   APPLE_APP_STORE_SHARED_SECRET — legacy verifyReceipt only (not used by Server API + StoreKit 2 path)
#
# Webhooks (no env secret like Stripe whsec_): register in App Store Connect → App Store Server Notifications V2:
#   Production: {BETTER_AUTH_URL}/api/v1/webhooks/apple
#   Sandbox:    https://staging.eklan.ai/api/v1/webhooks/apple  (or ngrok for local)
# Admin: GET /api/v1/admin/users/apple-sync?originalTransactionId=... — lookup user by Apple id
#        POST /api/v1/admin/users/apple-sync — re-sync from App Store (missed webhook recovery)
#
# Note: `iapAccountToken` (the UUID mobile passes to StoreKit as `appAccountToken`) is a
# database field generated automatically server-side on first login/profile fetch — it is
# NOT an env var and has no .env entry. See MOBILE_EXPO_BILLING.md.
#
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_KEY_ID=
# Contents of AuthKey_XXXX.p8 (multiline PEM; escape newlines or inject via host secret manager)
APPLE_APP_STORE_PRIVATE_KEY=
# iOS bundle identifier — MUST match mobile app.json / EAS (native Sign in with Apple JWT aud)
APPLE_BUNDLE_ID=com.eklan.ai
# Auto-renewable subscription product id from App Store Connect, e.g. com.eklan.ai.pro.monthly
APPLE_PRO_MONTHLY_PRODUCT_ID=
# sandbox | production — which App Store Server API host to call.
# REQUIRED: there is no code-level default anymore. The app throws a clear startup/request
# error if this is unset or has any value other than exactly "sandbox" or "production", so
# it must be explicitly set in every environment (local, staging, production).
APPLE_APP_STORE_ENVIRONMENT=sandbox
# Optional: legacy verifyReceipt shared secret
APPLE_APP_STORE_SHARED_SECRET=
# Required in production; optional in sandbox.
# APPLE_APP_APPLE_ID=

# --- Misc -------------------------------------------------------------------
BOOK_CALL_EMAIL=
LOG_LEVEL=info

# --- Integration tests (scripts/test-subscription-gates.mjs) ---------------
# Admin account used to upgrade/downgrade the test student via the admin API.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
# A real student account to test gating against.
# The script resets this user to free → premium → free automatically.
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=

WEEKLY_CHALLENGE_CRON_SECRET=
ADMIN_REPORT_EMAIL=
AI_DEV_EMAIL=

# --- Mobile force update (see MOBILE_FORCE_UPDATE_CONTRACT.md) --------------
# GET /api/v1/mobile/app-config — public, no auth. Only raise the minimum
# versions when users must leave the old binary (breaking API, critical fix,
# store-only change); otherwise leave them at the current store version.
# Defaults if unset: mins "1.3.4"; store URLs / copy as in the contract doc.
MOBILE_MINIMUM_IOS_VERSION=1.3.4
MOBILE_MINIMUM_ANDROID_VERSION=1.3.4
MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id6759982033
MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.eklan.ai
MOBILE_FORCE_UPDATE_TITLE=Update required
MOBILE_FORCE_UPDATE_MESSAGE=A new version of Eklan is required to continue. Please update from the store.