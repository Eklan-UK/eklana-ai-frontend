{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/v1/cron/class-session-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/cron/class-session-nps",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/cron/drill-streak-reminder",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/v1/cron/drill-daily-practice-reminder",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/v1/cron/weekly-drill-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/v1/cron/weekly-challenge",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "src/app/api/v1/drills/ai-generate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/v1/drills/ai-chat/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/v1/drills/bulk-create-assign/route.ts": {
      "maxDuration": 60
    }
  }
}
